---
import type { Announcement } from "../types";
import { withLocale } from "../utils/url";
import { useTranslations, defaultLocale, type Locale } from "../i18n/ui";

interface Props {
  announcement: Announcement;
  locale?: Locale;
}

const { announcement, locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);
const urgent = Boolean(announcement.urgent);

const categoryLabels: Record<Announcement["category"], string> = {
  elections: t("announcementCategories.elections"),
  schedule: t("announcementCategories.schedule"),
  general: t("announcementCategories.general"),
};
---

<div
  class={`glass-panel mt-6 px-6 py-5 flex flex-wrap items-center gap-4 border-l-4 ${urgent ? "border-l-brand-terracotta bg-brand-terracotta/5" : "border-l-brand-pine bg-brand-pine/5"}`}
  data-announcement-banner
  data-announcement-slug={announcement.slug}
  data-announcement-expires={announcement.expiresDate}
  style="display: none"
>
  <div
    class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${urgent ? "text-brand-terracotta bg-brand-terracotta/10" : "text-brand-pine bg-brand-pine/10"}`}
    aria-hidden="true"
  >
    <i class={urgent ? "fa-solid fa-triangle-exclamation" : "fa-solid fa-bullhorn"}></i>
  </div>
  <div class="flex-1 min-w-[200px]">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-mist">
      {categoryLabels[announcement.category]}
    </p>
    <p class="text-brand-rocky font-semibold">
      {announcement.title}
    </p>
  </div>
  <a
    href={withLocale(locale, "/announcements")}
    class="inline-flex items-center gap-2 whitespace-nowrap text-sm font-semibold text-brand-pine hover:text-brand-terracotta"
  >
    {t("announcementBanner.viewAll")}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="h-4 w-4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"></path>
    </svg>
  </a>
  <button
    type="button"
    data-announcement-dismiss
    aria-label={t("announcementBanner.dismissAria")}
    class="inline-flex h-8 w-8 items-center justify-center rounded-full text-brand-mist transition hover:bg-brand-terracotta/10 hover:text-brand-terracotta"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="h-4 w-4"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>
</div>
