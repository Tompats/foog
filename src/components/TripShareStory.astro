---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Trip } from "../types";
import { getTripTimelineStatus } from "../types";
import { siteMetadata } from "../data/site";
import hikingCardImage from "../assets/cards/hiking-card.jpg";
import mountaineeringCardImage from "../assets/cards/mountaineering-card.jpg";
import skiCardImage from "../assets/cards/ski-card.jpg";
import { withBase } from "../utils/url";
import { useTranslations, defaultLocale, type Locale } from "../i18n/ui";

interface Props {
  trip: Trip;
  locale?: Locale;
  /** "button" for the trip detail hero, "compact" for trip cards. */
  variant?: "button" | "compact";
}

const { trip, locale = defaultLocale, variant = "button" } = Astro.props;
const t = useTranslations(locale);

const cardImageMap: Record<Trip["type"], ImageMetadata> = {
  hiking: hikingCardImage,
  mountaineering: mountaineeringCardImage,
  ski: skiCardImage,
};

// Tall enough to cover the top of a 1080x1920 story without upscaling.
const backgroundImage = await getImage({
  src: cardImageMap[trip.type],
  height: 1200,
  format: "jpg",
});

// Greek capitals drop their accents, so strip them before uppercasing labels.
const toUpperLabel = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toLocaleUpperCase(locale === "en" ? "en-GB" : "el-GR");

const dateFormatter = new Intl.DateTimeFormat(
  locale === "en" ? "en-GB" : "el-GR",
  { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" },
);
const startDate = new Date(trip.startDate);
const endDate = trip.endDate ? new Date(trip.endDate) : null;
const dateLabel =
  endDate && endDate.getTime() !== startDate.getTime()
    ? dateFormatter.formatRange(startDate, endDate)
    : dateFormatter.format(startDate);

const durationDays = endDate
  ? Math.round((endDate.getTime() - startDate.getTime()) / 86_400_000) + 1
  : 1;

const typeLabelMap: Record<Trip["type"], string> = {
  hiking: t("tripTypes.hiking"),
  mountaineering: t("tripTypes.mountaineering"),
  ski: t("tripTypes.ski"),
};

const timelineStatus = getTripTimelineStatus(trip);
const statusLabel =
  trip.status === "canceled"
    ? t("tripStatus.canceledBadge")
    : trip.status === "postponed"
      ? t("tripStatus.postponedBadge")
      : null;
const tagline =
  trip.status !== "active"
    ? null
    : timelineStatus === "upcoming"
      ? t("tripShare.upcomingTagline")
      : t("tripShare.pastTagline");

const stats =
  trip.type === "ski"
    ? [
        {
          label: toUpperLabel(t("common.duration")),
          value: `${durationDays} ${durationDays === 1 ? t("common.day") : t("common.days")}`,
        },
      ]
    : [
        { label: toUpperLabel(t("common.distance")), value: `${trip.distanceKm} km` },
        { label: toUpperLabel(t("common.elevation")), value: `${trip.elevationGain} m` },
      ];

const instagramHandle = `@${siteMetadata.socials.instagram
  .replace(/\/+$/, "")
  .split("/")
  .pop()}`;

const shareData = {
  slug: trip.slug,
  title: trip.title,
  typeLabel: toUpperLabel(typeLabelMap[trip.type]),
  statusLabel: statusLabel ? toUpperLabel(statusLabel) : null,
  tagline,
  dateLabel,
  location: trip.location,
  stats,
  difficulty: trip.difficulty,
  difficultyLabel: toUpperLabel(t("common.difficulty")),
  brandMark: t("nav.brandMark"),
  brandTagline: t("nav.tagline"),
  siteLabel: new URL(siteMetadata.siteUrl).host,
  instagramHandle,
  backgroundUrl: backgroundImage.src,
  logoUrl: withBase("/favicon.png"),
};
---

<div data-trip-share class="contents">
  {
    variant === "compact" ? (
      <button
        type="button"
        data-trip-share-open
        aria-label={`${t("tripShare.button")}: ${trip.title}`}
        class="inline-flex items-center gap-2 rounded-full border border-brand-pine/20 px-4 py-2 text-sm font-semibold text-brand-pine transition hover:-translate-y-0.5 hover:border-brand-terracotta hover:text-brand-terracotta"
      >
        {t("tripShare.button")}
        <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
      </button>
    ) : (
      <button
        type="button"
        data-trip-share-open
        class="inline-flex items-center gap-2 rounded-full border border-brand-river/40 px-6 py-3 font-semibold text-brand-rocky transition hover:border-brand-terracotta"
      >
        <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
        {t("tripShare.button")}
      </button>
    )
  }

  <dialog
    data-trip-share-dialog
    aria-labelledby={`trip-share-title-${variant}-${trip.slug}`}
    class="w-[min(92vw,26rem)] overflow-hidden rounded-[28px] border border-brand-river/25 bg-brand-cloud/80 p-0 text-brand-rocky shadow-xl shadow-brand-river/30 backdrop-blur-md backdrop:bg-brand-rocky/70 backdrop:backdrop-blur-sm"
  >
    <div
      class="flex flex-col gap-4 p-5 bg-gradient-to-br from-brand-river/10 via-brand-cloud to-brand-river/5"
    >
      <div class="flex items-center justify-between gap-4">
        <h2
          id={`trip-share-title-${variant}-${trip.slug}`}
          class="text-xl font-semibold heading-font"
        >
          {t("tripShare.dialogTitle")}
        </h2>
        <button
          type="button"
          data-trip-share-close
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-brand-river/30 text-brand-river hover:text-brand-terracotta"
          aria-label={t("tripShare.close")}
        >
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>

      <div
        class="relative mx-auto aspect-[9/16] w-full max-h-[60vh] overflow-hidden rounded-2xl bg-[#0f1a1b]"
        style="max-width: calc(60vh * 9 / 16);"
      >
        <p
          data-trip-share-status
          class="absolute inset-0 flex items-center justify-center p-6 text-center text-sm text-brand-mistLight"
        >
          {t("tripShare.generating")}
        </p>
        <img
          data-trip-share-preview
          alt={`${t("tripShare.previewAlt")}: ${trip.title}`}
          class="hidden h-full w-full object-cover"
        />
      </div>

      <p class="text-sm text-brand-mist">{t("tripShare.hint")}</p>

      <div class="flex flex-wrap gap-3">
        <button
          type="button"
          data-trip-share-native
          disabled
          class="hidden flex-1 items-center justify-center gap-2 rounded-full bg-brand-terracotta px-5 py-3 font-semibold text-brand-cloud shadow-md shadow-brand-terracotta/40 transition hover:scale-105 disabled:opacity-60"
        >
          <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
          {t("tripShare.share")}
        </button>
        <a
          data-trip-share-download
          aria-disabled="true"
          class="pointer-events-none flex flex-1 items-center justify-center gap-2 rounded-full border border-brand-river/40 px-5 py-3 font-semibold text-brand-rocky opacity-60 hover:border-brand-terracotta"
        >
          <i class="fa-solid fa-download" aria-hidden="true"></i>
          {t("tripShare.download")}
        </a>
      </div>
    </div>
  </dialog>

  <script
    type="application/json"
    data-trip-share-data
    set:html={JSON.stringify(shareData).replace(/</g, "\\u003c")}
  />
  <script type="application/json" data-trip-share-error set:html={JSON.stringify(t("tripShare.error"))} />
</div>

<script>
  interface ShareData {
    slug: string;
    title: string;
    typeLabel: string;
    statusLabel: string | null;
    tagline: string | null;
    dateLabel: string;
    location: string;
    stats: { label: string; value: string }[];
    difficulty: number;
    difficultyLabel: string;
    brandMark: string;
    brandTagline: string;
    siteLabel: string;
    instagramHandle: string;
    backgroundUrl: string;
    logoUrl: string;
  }

  const WIDTH = 1080;
  const HEIGHT = 1920;
  const PADDING = 88;
  const HERO_HEIGHT = 1180;
  const COLORS = {
    night: "#0f1a1b",
    pine: "#356859",
    cloud: "#FDFAF6",
    terracotta: "#E26D5A",
    moss: "#A7C957",
    mistLight: "#b7c3c5",
  };
  const HEADING_FONT = '"Quicksand", "Nunito", system-ui, sans-serif';
  const BODY_FONT = '"Nunito", system-ui, sans-serif';

  const loadImage = (src: string) =>
    new Promise<HTMLImageElement>((resolve, reject) => {
      const image = new Image();
      image.decoding = "async";
      image.onload = () => resolve(image);
      image.onerror = () => reject(new Error(`Failed to load ${src}`));
      image.src = src;
    });

  const loadFonts = async (sample: string) => {
    if (!document.fonts) return;
    await Promise.allSettled([
      document.fonts.load(`700 96px ${HEADING_FONT}`, sample),
      document.fonts.load(`700 40px ${BODY_FONT}`, sample),
      document.fonts.load(`600 32px ${BODY_FONT}`, sample),
    ]);
  };

  const wrapText = (
    ctx: CanvasRenderingContext2D,
    text: string,
    maxWidth: number,
  ) => {
    const words = text.split(/\s+/).filter(Boolean);
    const lines: string[] = [];
    let current = "";
    for (const word of words) {
      const candidate = current ? `${current} ${word}` : word;
      if (current && ctx.measureText(candidate).width > maxWidth) {
        lines.push(current);
        current = word;
      } else {
        current = candidate;
      }
    }
    if (current) lines.push(current);
    return lines;
  };

  const roundedRect = (
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    w: number,
    h: number,
    r: number,
  ) => {
    ctx.beginPath();
    ctx.roundRect(x, y, w, h, r);
  };

  const drawPill = (
    ctx: CanvasRenderingContext2D,
    text: string,
    x: number,
    y: number,
    fill: string,
    color: string,
  ) => {
    ctx.font = `700 26px ${BODY_FONT}`;
    ctx.letterSpacing = "5px";
    const width = ctx.measureText(text).width + 56;
    const height = 60;
    roundedRect(ctx, x, y, width, height, height / 2);
    ctx.fillStyle = fill;
    ctx.fill();
    ctx.fillStyle = color;
    ctx.textBaseline = "middle";
    ctx.fillText(text, x + 28, y + height / 2 + 1);
    ctx.letterSpacing = "0px";
    return width;
  };

  const drawCover = (
    ctx: CanvasRenderingContext2D,
    image: HTMLImageElement,
    w: number,
    h: number,
  ) => {
    const scale = Math.max(w / image.naturalWidth, h / image.naturalHeight);
    const sw = w / scale;
    const sh = h / scale;
    const sx = (image.naturalWidth - sw) / 2;
    const sy = (image.naturalHeight - sh) / 2;
    ctx.drawImage(image, sx, sy, sw, sh, 0, 0, w, h);
  };

  const drawMountainPattern = (ctx: CanvasRenderingContext2D, top: number) => {
    ctx.save();
    ctx.strokeStyle = "rgba(95, 142, 132, 0.18)";
    ctx.lineWidth = 5;
    ctx.lineJoin = "round";
    for (let row = top; row < HEIGHT + 180; row += 180) {
      for (let col = -40; col < WIDTH; col += 260) {
        ctx.beginPath();
        ctx.moveTo(col, row + 140);
        [
          [50, 80],
          [100, 140],
          [150, 70],
          [200, 140],
          [250, 90],
          [300, 140],
        ].forEach(([dx, dy]) => ctx.lineTo(col + dx, row + dy));
        ctx.stroke();
      }
    }
    ctx.restore();
  };

  const drawPin = (ctx: CanvasRenderingContext2D, x: number, y: number) => {
    // Map-pin glyph centred horizontally on x, top at y (≈ 40px tall).
    ctx.save();
    ctx.fillStyle = COLORS.terracotta;
    ctx.beginPath();
    ctx.arc(x, y + 14, 14, Math.PI, 0);
    ctx.bezierCurveTo(x + 14, y + 26, x + 4, y + 32, x, y + 40);
    ctx.bezierCurveTo(x - 4, y + 32, x - 14, y + 26, x - 14, y + 14);
    ctx.fill();
    ctx.fillStyle = COLORS.night;
    ctx.beginPath();
    ctx.arc(x, y + 14, 5.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  };

  const renderStory = async (data: ShareData) => {
    const sample = [
      data.title,
      data.location,
      data.dateLabel,
      data.brandTagline,
      data.typeLabel,
      ...data.stats.flatMap((stat) => [stat.label, stat.value]),
    ].join(" ");
    const [background, logo] = await Promise.all([
      loadImage(data.backgroundUrl),
      loadImage(data.logoUrl).catch(() => null),
      loadFonts(sample),
    ]);

    const canvas = document.createElement("canvas");
    canvas.width = WIDTH;
    canvas.height = HEIGHT;
    const ctx = canvas.getContext("2d");
    if (!ctx) throw new Error("Canvas not supported");

    // Base: the site's night → pine → night gradient with the mountain motif.
    // Starts as solid night where the hero artwork fades out, so there is no seam.
    const base = ctx.createLinearGradient(0, 0, 0, HEIGHT);
    base.addColorStop(0, COLORS.night);
    base.addColorStop(HERO_HEIGHT / HEIGHT, COLORS.night);
    base.addColorStop(0.8, "#1d3b36");
    base.addColorStop(1, COLORS.night);
    ctx.fillStyle = base;
    ctx.fillRect(0, 0, WIDTH, HEIGHT);
    drawMountainPattern(ctx, HERO_HEIGHT - 60);

    // Hero artwork, faded into the base.
    drawCover(ctx, background, WIDTH, HERO_HEIGHT);
    const fade = ctx.createLinearGradient(0, 0, 0, HERO_HEIGHT);
    fade.addColorStop(0, "rgba(15, 26, 27, 0.55)");
    fade.addColorStop(0.22, "rgba(15, 26, 27, 0.05)");
    fade.addColorStop(0.55, "rgba(15, 26, 27, 0.35)");
    fade.addColorStop(1, "rgba(15, 26, 27, 1)");
    ctx.fillStyle = fade;
    ctx.fillRect(0, 0, WIDTH, HERO_HEIGHT);

    const glow = ctx.createRadialGradient(
      WIDTH * 0.85,
      HEIGHT * 0.62,
      0,
      WIDTH * 0.85,
      HEIGHT * 0.62,
      700,
    );
    glow.addColorStop(0, "rgba(167, 201, 87, 0.16)");
    glow.addColorStop(1, "rgba(167, 201, 87, 0)");
    ctx.fillStyle = glow;
    ctx.fillRect(0, 0, WIDTH, HEIGHT);

    // Header (kept below Instagram's top progress bar / profile row).
    const headerY = 170;
    const logoSize = 104;
    if (logo) {
      ctx.save();
      roundedRect(ctx, PADDING, headerY, logoSize, logoSize, 28);
      ctx.clip();
      ctx.drawImage(logo, PADDING, headerY, logoSize, logoSize);
      ctx.restore();
      roundedRect(ctx, PADDING, headerY, logoSize, logoSize, 28);
      ctx.strokeStyle = "rgba(253, 250, 246, 0.6)";
      ctx.lineWidth = 3;
      ctx.stroke();
    }
    const headerTextX = PADDING + (logo ? logoSize + 28 : 0);
    ctx.textBaseline = "alphabetic";
    ctx.fillStyle = COLORS.cloud;
    ctx.shadowColor = "rgba(0, 0, 0, 0.35)";
    ctx.shadowBlur = 16;
    ctx.font = `700 48px ${HEADING_FONT}`;
    ctx.fillText(data.brandMark, headerTextX, headerY + 50);
    ctx.font = `600 26px ${BODY_FONT}`;
    ctx.fillStyle = "rgba(253, 250, 246, 0.9)";
    const taglineMax = WIDTH - headerTextX - PADDING;
    let brandTagline = data.brandTagline;
    while (ctx.measureText(brandTagline).width > taglineMax && brandTagline.length > 4) {
      brandTagline = `${brandTagline.slice(0, -2).trimEnd()}…`;
    }
    ctx.fillText(brandTagline, headerTextX, headerY + 90);
    ctx.shadowBlur = 0;
    ctx.shadowColor = "transparent";

    // Measure the content block so it can be anchored above the footer,
    // shrinking the title until everything fits below the header.
    const contentWidth = WIDTH - PADDING * 2;
    const footerTop = 1600;
    const contentTop = 600;
    const statCount = data.stats.length + 1;
    const statGap = 24;
    const statHeight = 180;
    const pillsHeight = 60;
    const taglineHeight = data.tagline ? 72 : 0;

    ctx.font = `600 38px ${BODY_FONT}`;
    const locationLines = wrapText(ctx, data.location, contentWidth - 56).slice(0, 2);

    const measureBlock = (lineCount: number, lineHeight: number) =>
      taglineHeight +
      pillsHeight +
      44 +
      48 + // date
      28 +
      lineCount * lineHeight +
      28 +
      locationLines.length * 50 +
      56 +
      statHeight;

    let titleSize = 104;
    let titleLines: string[] = [];
    let titleLineHeight = 0;
    let blockHeight = 0;
    do {
      ctx.font = `700 ${titleSize}px ${HEADING_FONT}`;
      titleLines = wrapText(ctx, data.title, contentWidth);
      titleLineHeight = Math.round(titleSize * 1.12);
      blockHeight = measureBlock(titleLines.length, titleLineHeight);
      const fits =
        titleLines.length <= 3 && footerTop - 70 - blockHeight >= contentTop;
      if (fits || titleSize <= 60) break;
      titleSize -= 4;
    } while (true);

    let y = Math.max(contentTop, footerTop - 70 - blockHeight);

    ctx.shadowColor = "rgba(0, 0, 0, 0.45)";
    ctx.shadowBlur = 18;
    if (data.tagline) {
      ctx.font = `700 44px ${HEADING_FONT}`;
      ctx.fillStyle = COLORS.moss;
      ctx.textBaseline = "top";
      ctx.fillText(data.tagline, PADDING, y);
      y += taglineHeight;
    }
    ctx.shadowBlur = 0;
    ctx.shadowColor = "transparent";

    let pillX = PADDING;
    pillX += drawPill(ctx, data.typeLabel, pillX, y, COLORS.cloud, COLORS.pine) + 16;
    if (data.statusLabel) {
      drawPill(ctx, data.statusLabel, pillX, y, COLORS.terracotta, COLORS.cloud);
    }
    y += pillsHeight + 44;

    ctx.textBaseline = "top";
    ctx.font = `700 42px ${BODY_FONT}`;
    ctx.fillStyle = COLORS.moss;
    ctx.shadowColor = "rgba(0, 0, 0, 0.45)";
    ctx.shadowBlur = 18;
    ctx.fillText(data.dateLabel, PADDING, y);
    y += 48 + 28;

    ctx.font = `700 ${titleSize}px ${HEADING_FONT}`;
    ctx.fillStyle = COLORS.cloud;
    ctx.shadowColor = "rgba(0, 0, 0, 0.3)";
    ctx.shadowBlur = 20;
    titleLines.forEach((line, index) => {
      ctx.fillText(line, PADDING, y + index * titleLineHeight);
    });
    ctx.shadowBlur = 0;
    ctx.shadowColor = "transparent";
    y += titleLines.length * titleLineHeight + 28;

    ctx.font = `600 38px ${BODY_FONT}`;
    // Centre the 40px pin on the capital height of the first location line.
    const capMetrics = ctx.measureText("H");
    const capCenter =
      y + (capMetrics.actualBoundingBoxDescent - capMetrics.actualBoundingBoxAscent) / 2;
    drawPin(ctx, PADDING + 14, capCenter - 20);
    ctx.fillStyle = "rgba(253, 250, 246, 0.9)";
    locationLines.forEach((line, index) => {
      ctx.fillText(line, PADDING + 56, y + index * 50);
    });
    y += locationLines.length * 50 + 56;

    // Stat tiles.
    const statWidth = (contentWidth - statGap * (statCount - 1)) / statCount;
    const tiles = [
      ...data.stats.map((stat) => ({ ...stat, difficulty: false })),
      { label: data.difficultyLabel, value: `${data.difficulty}/5`, difficulty: true },
    ];
    tiles.forEach((tile, index) => {
      const x = PADDING + index * (statWidth + statGap);
      roundedRect(ctx, x, y, statWidth, statHeight, 32);
      ctx.fillStyle = "rgba(253, 250, 246, 0.08)";
      ctx.fill();
      ctx.strokeStyle = "rgba(253, 250, 246, 0.18)";
      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.textBaseline = "top";
      ctx.letterSpacing = "4px";
      let labelSize = 22;
      do {
        ctx.font = `700 ${labelSize}px ${BODY_FONT}`;
      } while (ctx.measureText(tile.label).width > statWidth - 60 && --labelSize > 14);
      ctx.fillStyle = COLORS.mistLight;
      ctx.fillText(tile.label, x + 30, y + 32);
      ctx.letterSpacing = "0px";

      ctx.font = `700 54px ${HEADING_FONT}`;
      ctx.fillStyle = COLORS.cloud;
      ctx.fillText(tile.value, x + 30, y + 70);

      if (tile.difficulty) {
        for (let level = 0; level < 5; level += 1) {
          ctx.beginPath();
          ctx.arc(x + 42 + level * 30, y + 150, 10, 0, Math.PI * 2);
          ctx.fillStyle =
            level < data.difficulty ? COLORS.moss : "rgba(253, 250, 246, 0.2)";
          ctx.fill();
        }
      }
    });

    // Footer (kept above Instagram's bottom reply bar).
    ctx.textBaseline = "middle";
    const footerHeight = 76;
    ctx.font = `700 34px ${BODY_FONT}`;
    const siteWidth = ctx.measureText(data.siteLabel).width + 64;
    roundedRect(ctx, PADDING, footerTop, siteWidth, footerHeight, footerHeight / 2);
    ctx.fillStyle = COLORS.terracotta;
    ctx.fill();
    ctx.fillStyle = COLORS.cloud;
    ctx.fillText(data.siteLabel, PADDING + 32, footerTop + footerHeight / 2 + 1);

    ctx.font = `600 32px ${BODY_FONT}`;
    ctx.fillStyle = "rgba(253, 250, 246, 0.85)";
    ctx.textAlign = "right";
    ctx.fillText(data.instagramHandle, WIDTH - PADDING, footerTop + footerHeight / 2 + 1);
    ctx.textAlign = "left";

    return new Promise<Blob>((resolve, reject) => {
      canvas.toBlob(
        (blob) => (blob ? resolve(blob) : reject(new Error("Export failed"))),
        "image/jpeg",
        0.92,
      );
    });
  };

  // The site uses Astro's ClientRouter, so bind on every page load (not just
  // the first) and skip roots that are already wired up.
  const initTripShare = () => {
    document.querySelectorAll<HTMLElement>("[data-trip-share]").forEach((root) => {
      if (root.dataset.tripShareReady) return;
      root.dataset.tripShareReady = "true";

      const dataElement = root.querySelector("[data-trip-share-data]");
      const errorElement = root.querySelector("[data-trip-share-error]");
      const openButton = root.querySelector<HTMLButtonElement>("[data-trip-share-open]");
      const dialog = root.querySelector<HTMLDialogElement>("[data-trip-share-dialog]");
      const closeButton = root.querySelector<HTMLButtonElement>("[data-trip-share-close]");
      const preview = root.querySelector<HTMLImageElement>("[data-trip-share-preview]");
      const status = root.querySelector<HTMLElement>("[data-trip-share-status]");
      const nativeButton = root.querySelector<HTMLButtonElement>("[data-trip-share-native]");
      const downloadLink = root.querySelector<HTMLAnchorElement>("[data-trip-share-download]");
      if (
        !dataElement || !openButton || !dialog || !closeButton || !preview ||
        !status || !nativeButton || !downloadLink
      ) {
        return;
      }

      const data = JSON.parse(dataElement.textContent ?? "{}") as ShareData;
      const errorMessage = JSON.parse(errorElement?.textContent ?? '""') as string;
      const fileName = `foog-${data.slug}-story.jpg`;
      let file: File | null = null;
      let rendering: Promise<void> | null = null;

      const render = () => {
        rendering ??= renderStory(data)
          .then((blob) => {
            file = new File([blob], fileName, { type: "image/jpeg" });
            const url = URL.createObjectURL(blob);
            preview.src = url;
            preview.classList.remove("hidden");
            status.classList.add("hidden");

            downloadLink.href = url;
            downloadLink.download = fileName;
            downloadLink.removeAttribute("aria-disabled");
            downloadLink.classList.remove("pointer-events-none", "opacity-60");

            if (navigator.canShare?.({ files: [file] })) {
              nativeButton.classList.remove("hidden");
              nativeButton.classList.add("inline-flex");
              nativeButton.disabled = false;
            }
          })
          .catch((error) => {
            console.error(error);
            status.textContent = errorMessage;
            rendering = null;
          });
        return rendering;
      };

      openButton.addEventListener("click", () => {
        dialog.showModal();
        render();
      });

      closeButton.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      nativeButton.addEventListener("click", async () => {
        if (!file) return;
        try {
          await navigator.share({ files: [file], title: data.title });
        } catch (error) {
          if ((error as DOMException).name !== "AbortError") console.error(error);
        }
      });
    });
  };

  document.addEventListener("astro:page-load", initTripShare);
</script>
