---
import TripCard from "./TripCard.astro";
import SectionHeader from "./SectionHeader.astro";
import type { Trip, TripType } from "../types";
import { withLocale } from "../utils/url";
import { useTranslations, defaultLocale, type Locale } from "../i18n/ui";

interface PaginationMeta {
  currentPage: number;
  totalPages: number;
  totalPastTrips: number;
}

interface Props {
  upcomingTrips: Trip[];
  pastTrips: Trip[];
  pagination: PaginationMeta;
  locale?: Locale;
}

const { upcomingTrips, pastTrips, pagination, locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);

const tripTypes = ["hiking", "mountaineering", "ski"] as const;
const difficulties = [1, 2, 3, 4, 5];
const typeLabelMap: Record<(typeof tripTypes)[number], string> = {
  hiking: t("tripTypes.hiking"),
  mountaineering: t("tripTypes.mountaineering"),
  ski: t("tripTypes.ski"),
};
const typeFilterOptions: (TripType | "all")[] = ["all", ...tripTypes];
const difficultyFilterOptions: (number | "all")[] = ["all", ...difficulties];

const pageHref = (pageNumber: number, hash?: string) => {
  const base = pageNumber === 1
    ? withLocale(locale, "/trips")
    : withLocale(locale, `/trips/page/${pageNumber}`);
  return hash ? `${base}${hash}` : base;
};
---

<section class="section-padding" data-reveal>
  <SectionHeader
    eyebrow={t("tripsPage.heroEyebrow")}
    title={t("tripsPage.heroTitle")}
    subtitle={t("tripsPage.heroSubtitle")}
    level={1}
  />
  <div class="glass-panel p-6 mb-12">
    <p class="text-sm uppercase tracking-[0.3em] text-brand-mist">
      {t("tripsPage.filtersLabel")}
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      {
        typeFilterOptions.map((typeOption) => (
          <button
            type="button"
            class="rounded-full border border-brand-river/30 bg-brand-cloud px-4 py-2 text-sm text-brand-rocky shadow-sm hover:-translate-y-0.5"
            data-filter-type={typeOption}
            aria-pressed={typeOption === "all" ? "true" : "false"}
          >
            {typeOption === "all"
              ? t("tripsPage.allActivities")
              : typeLabelMap[typeOption]}
          </button>
        ))
      }
    </div>
    <div class="mt-4 flex flex-wrap gap-3">
      {
        difficultyFilterOptions.map((level) => (
          <button
            type="button"
            class="rounded-full border border-brand-river/20 bg-brand-cloud px-4 py-2 text-sm text-brand-mist shadow-sm hover:-translate-y-0.5"
            data-filter-difficulty={level}
            aria-pressed={level === "all" ? "true" : "false"}
          >
            {level === "all" ? t("tripsPage.allDifficulties") : `${t("tripsPage.difficultyPrefix")} ${level}`}
          </button>
        ))
      }
    </div>
    <p
      id="filters-empty-state"
      class="hidden mt-4 text-sm text-brand-mist"
      role="status"
    >
      {t("tripsPage.emptyFilterState")}
    </p>
  </div>
  <div class="space-y-16">
    <div>
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-2xl font-semibold text-brand-cloud">
          {t("tripsPage.upcomingHeading")}
        </h3>
        <span class="text-sm text-brand-mist"
          >{upcomingTrips.length} {t("tripsPage.upcomingCountSuffix")}</span
        >
      </div>
      {
        upcomingTrips.length > 0 ? (
          <div class="grid gap-6 lg:grid-cols-2">
            {upcomingTrips.map((trip) => <TripCard trip={trip} locale={locale} />)}
          </div>
        ) : (
          <div class="glass-panel p-6 text-brand-mist">
            <p class="text-lg font-semibold text-brand-rocky">
              {t("tripsPage.noUpcomingTitle")}
            </p>
            <p class="mt-2">
              {t("tripsPage.noUpcomingBody")}
            </p>
          </div>
        )
      }
    </div>
    <div
      id="past-trips"
      style="scroll-margin-top: 5rem;"
      class="space-y-6"
    >
      <div class="flex items-center justify-between mb-0">
        <h3 class="text-2xl font-semibold text-brand-cloud">
          {t("tripsPage.pastHeading")}
        </h3>
        <span class="text-sm text-brand-mist"
          >{pagination.totalPastTrips} {t("tripsPage.pastCountSuffix")}</span
        >
      </div>
      {
        pastTrips.length > 0 ? (
          <div class="grid gap-6 lg:grid-cols-2">
            {pastTrips.map((trip) => <TripCard trip={trip} locale={locale} />)}
          </div>
        ) : (
          <div class="glass-panel p-6 text-brand-mist">
            <p class="text-lg font-semibold text-brand-rocky">
              {t("tripsPage.noPastTitle")}
            </p>
            <p class="mt-2">
              {t("tripsPage.noPastBody")}
            </p>
          </div>
        )
      }
      {
        pagination.totalPages > 1 && (
          <div class="mt-6 flex flex-wrap items-center gap-4 justify-between border-t border-brand-cloud/10 pt-4">
            <span class="text-sm text-brand-mist">
              {t("tripsPage.pagePrefix")} {pagination.currentPage} {t("tripsPage.pageOfConnector")} {pagination.totalPages}
            </span>
            <div class="flex gap-3">
              {
                pagination.currentPage > 1 && (
                  <a
                    href={pageHref(pagination.currentPage - 1, '#past-trips')}
                    class="rounded-full border border-brand-cloud/40 px-4 py-2 text-sm font-semibold text-brand-cloud hover:border-brand-terracotta"
                  >
                    {t("tripsPage.prevPage")}
                  </a>
                )
              }
              {
                pagination.currentPage < pagination.totalPages && (
                  <a
                    href={pageHref(pagination.currentPage + 1, '#past-trips')}
                    class="rounded-full border border-brand-cloud/40 px-4 py-2 text-sm font-semibold text-brand-cloud hover:border-brand-terracotta"
                  >
                    {t("tripsPage.nextPage")}
                  </a>
                )
              }
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
<script>
  (() => {
    const initFilters = () => {
    const typeButtons = document.querySelectorAll<HTMLButtonElement>(
      '[data-filter-type]'
    );
    const difficultyButtons = document.querySelectorAll<HTMLButtonElement>(
      '[data-filter-difficulty]'
    );
    if (!typeButtons.length && !difficultyButtons.length) return;
    const cards = document.querySelectorAll<HTMLElement>('[data-trip-card]');
    const emptyState = document.getElementById('filters-empty-state');
    let activeType = "all";
    let activeDifficulty = "all";

    const setActive = (
      buttons: NodeListOf<HTMLButtonElement>,
      activeValue: string,
      attr: string
    ) => {
      buttons.forEach((button) => {
        const value = button.getAttribute(attr) ?? "all";
        const isActive = value === activeValue;
        button.classList.toggle("filter-active", isActive);
        button.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    };

    const applyFilters = () => {
      let visibleCount = 0;
      cards.forEach((card) => {
        const type = card.getAttribute("data-type") ?? "";
        const difficulty = card.getAttribute("data-difficulty") ?? "";
        const matchesType = activeType === "all" || type === activeType;
        const matchesDifficulty =
          activeDifficulty === "all" || difficulty === activeDifficulty;
        const matches = matchesType && matchesDifficulty;
        card.classList.toggle("hidden", !matches);
        if (matches) visibleCount += 1;
      });
      emptyState?.classList.toggle("hidden", visibleCount > 0);
    };

    typeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeType = button.getAttribute("data-filter-type") ?? "all";
        setActive(typeButtons, activeType, "data-filter-type");
        applyFilters();
      });
    });

    difficultyButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeDifficulty =
          button.getAttribute("data-filter-difficulty") ?? "all";
        setActive(
          difficultyButtons,
          activeDifficulty,
          "data-filter-difficulty"
        );
        applyFilters();
      });
    });

    setActive(typeButtons, activeType, "data-filter-type");
    setActive(difficultyButtons, activeDifficulty, "data-filter-difficulty");
    applyFilters();
    };

    document.addEventListener('astro:page-load', initFilters);
  })();
</script>
