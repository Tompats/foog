import photoAnixiatikiPezoporiaLivadi from "../../assets/images/foog-anixiatiki-pezoporia-livadi.jpg";
import photoPezoporiaDasosStasi from "../../assets/images/foog-pezoporia-dasos-stasi.jpg";
import photoXeimeriniPezoporiaGynaikes from "../../assets/images/foog-xeimerini-pezoporia-gynaikes.jpg";
import photoKatafygioAnodos from "../../assets/images/foog-anixiatiki-pezoporia-katafygio-anodos.jpg";
import photoKatafygioOmada from "../../assets/images/foog-anixiatiki-pezoporia-katafygio-omada.jpg";
import photoPezoporiaOmadaPoreia from "../../assets/images/foog-anixiatiki-pezoporia-omada-poreia.jpg";
import photoGlyptoOreivaton from "../../assets/images/foog-glypto-oreivaton.jpg";
import grammosVideo from "../../assets/videos/foog-grammos-video.mp4";
import paikoVideo from "../../assets/videos/paiko.mp4";
import verligkaVideo from "../../assets/videos/verligka.mp4";
import vardousiaVideo from "../../assets/videos/vardousia.mp4";
import grammosPoster from "../../assets/videos/posters/foog-grammos-video.jpg";
import paikoPoster from "../../assets/videos/posters/paiko.jpg";
import verligkaPoster from "../../assets/videos/posters/verligka.jpg";
import vardousiaPoster from "../../assets/videos/posters/vardousia.jpg";

const posterOptions = { width: 480, quality: 70 } as const;
const [
  grammosPosterSrc,
  verligkaPosterSrc,
  paikoPosterSrc,
  vardousiaPosterSrc,
] = await Promise.all([
  getImage({ src: grammosPoster, ...posterOptions }),
  getImage({ src: verligkaPoster, ...posterOptions }),
  getImage({ src: paikoPoster, ...posterOptions }),
  getImage({ src: vardousiaPoster, ...posterOptions }),
]).then((images) => images.map((image) => image.src));

interface GalleryItem {
  title: string;
  subtitle: string;
  image?: ImageMetadata;
  video?: string;
  poster?: string;
  alt?: string;
}

const locale = "en" as const;

const gallery: GalleryItem[] = [
  {
    title: "Ski training in Borovets",
    subtitle: "Skiing · 2024",
    image: photoBorovets,
    alt: "F.O.O.G. members on a ski slope in Borovets",
