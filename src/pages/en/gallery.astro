import photoAthamaniaRidge from "../../assets/images/foog-athamania.jpeg";
import photoAetomilitsa from "../../assets/images/foog-aetomilitsa.jpg";
import photoAetomilitsaGrammos from "../../assets/images/foog-aetomilitsa-grammos-1.jpeg";
import photoGrammos from "../../assets/images/foog-grammos.jpeg";
import photoPaiko from "../../assets/images/foog-katharismos-paiko.jpg";
import photoSkiJunior from "../../assets/images/foog-ski-junior.jpg";
import photoVoras from "../../assets/images/foog-voras-profitis-hlias.jpg";
import photoAgonistikoSki1 from "../../assets/images/foog-agonistiko-ski-1.jpg";
import photoAgonistikoSki3 from "../../assets/images/foog-agonistiko-ski-3.jpg";
import photoSkiCampOmada1 from "../../assets/images/foog-ski-camp-omada-1.jpg";
import photoSkiCampOmada2 from "../../assets/images/foog-ski-camp-omada-2.jpg";
import photoSkiCampOmada3 from "../../assets/images/foog-ski-camp-omada-3.jpg";
import photoSkiCampOmada4 from "../../assets/images/foog-ski-camp-omada-4.jpg";
import photoSkiCampOmada5 from "../../assets/images/foog-ski-camp-omada-5.jpg";
import photoSkiCampOmada6 from "../../assets/images/foog-ski-camp-omada-6.jpg";
import photoSkiCampXionoaggeloi from "../../assets/images/foog-ski-camp-xionoaggeloi.jpg";
import photoSkiCampAlexiptoto from "../../assets/images/foog-ski-camp-alexiptoto.jpg";
import photoSkiCampGyaliaSelfie from "../../assets/images/foog-ski-camp-gyalia-selfie.jpg";
import photoSnowboardCampJunior from "../../assets/images/foog-snowboard-camp-junior.jpg";
import photoSkiSxoliKoryfi from "../../assets/images/foog-ski-sxoli-koryfi.jpg";
import photoBorovetsKoryfi from "../../assets/images/foog-borovets-koryfi-2550.jpg";
import photoBorovetsTeleferik from "../../assets/images/foog-borovets-teleferik.jpg";
