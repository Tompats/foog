    image: photoPaiko,
    alt: "F.O.O.G. volunteers clearing a trail on Mount Paiko",
  },
  {
    title: "Junior ski team",
    subtitle: "Learning · 2024",
    image: photoSkiJunior,
    alt: "Children in ski gear during a lesson",
  },
  {
    title: "Snow-capped Profitis Ilias on Mount Voras",
    subtitle: "Summit trek · 2023",
    image: photoVoras,
    alt: "F.O.O.G. members next to the flag on Profitis Ilias, Mount Voras",
  },
  {
    title: "At 2550m in Borovets",
    subtitle: "Skiing · Borovets",
    image: photoBorovetsKoryfi,
    alt: "A large F.O.O.G. group at the 2550-meter point in Borovets",
  },
  {
    title: "By cable car through the snowy forest",
    subtitle: "Borovets",
    image: photoBorovetsTeleferik,
    alt: "View from a cable car through snow-covered fir trees in Borovets",
  },
  {
    title: "The whole crew on the slope",
    subtitle: "Skiing",
    image: photoSkiOmadaPlagia,
    alt: "A large group of skiers of all ages on a snowy slope",
  },
  {
    title: "Group at the top of the slope",
    subtitle: "Ski lesson",
