  },
  {
    title: "Endurance trek at Triethnes",
    subtitle: "Hiking · 2025",
    image: photoBorovetsHikingTwo,
    alt: "Members walking along a snowy ridge near Borovets",
  },
  {
    title: "Ascents in Athamania",
    subtitle: "Mountaineering · 2023",
    image: photoAthamania,
    alt: "F.O.O.G. group on the Athamania ridgeline",
  },
  {
    title: "Athamania ridge at first light",
    subtitle: "Mountaineering · 2024",
    image: photoAthamaniaRidge,
    alt: "The Athamania ridgeline with F.O.O.G. members",
  },
  {
    title: "Aetomilitsa at dusk",
    subtitle: "Hiking · 2024",
