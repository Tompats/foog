    subtitle: "Hiking",
    image: photoPezoporiaDasosStasi,
    alt: "A group of hikers stopping for a briefing in a deciduous forest",
  },
  {
    title: "A group of women in the snowy mountains",
    subtitle: "Hiking",
    image: photoXeimeriniPezoporiaGynaikes,
    alt: "Five women posing with snow-capped peaks in the background",
  },
  {
