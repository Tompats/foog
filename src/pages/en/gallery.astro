    alt: "F.O.O.G. flag on Mount Grammos with a panoramic view",
  },
  {
    title: "Snow-capped peaks of Grammos",
    subtitle: "Mountaineering · 2024",
    image: photoGrammos,
    alt: "F.O.O.G. athletes ascending Mount Grammos",
  },
  {
    title: "Gistova Dragon Lake",
    subtitle: "Video highlight · 2024",
    video: grammosVideo,
    poster: grammosPosterSrc,
    alt: "Video of F.O.O.G. members on Mount Grammos",
  },

  {
    title: "Verligka Dragon Lake",
    subtitle: "Video highlight · 2026",
    video: verligkaVideo,
    poster: verligkaPosterSrc,
    alt: "Video of F.O.O.G. members at Verligka Dragon Lake",
  },

  {
    title: "Hunter's Full Moon - Mount Paiko",
    subtitle: "Video highlight · 2025",
    video: paikoVideo,
