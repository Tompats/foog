const photoGallery = gallery.filter(
  (item): item is GalleryItem & { image: ImageMetadata } =>
    Boolean(item.image) && !item.video,
);
const videoGallery = gallery.filter((item) => item.video);
---

<BaseLayout
  locale={locale}
  title="Gallery"
  description="Photos from F.O.O.G.'s recent mountaineering, ski, and mentoring activities."
>
  <section class="section-padding" data-reveal>
    <SectionHeader
      eyebrow="Visual"
      title="Gallery"
      subtitle="Moments from our trips"
      level={1}
    />
    <div class="space-y-10">
      <div>
        <h3
          class="mb-4 text-sm font-semibold uppercase tracking-wide text-brand-river"
        >
          Photos
        </h3>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            photoGallery.map((item) => (
              <figure
                class="group relative h-72 sm:h-80 lg:h-72 overflow-hidden rounded-2xl"
                data-reveal
              >
                <Image
                  src={item.image}
                  alt={item.alt ?? item.title}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                  width={800}
                  widths={[400, 800]}
                  quality={75}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                />
                <figcaption class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition flex flex-col justify-end p-4">
                  <p class="text-white font-semibold">{item.title}</p>
                  <p class="text-sm text-brand-river">{item.subtitle}</p>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>

      {
        videoGallery.length > 0 && (
          <div>
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-brand-river">
              Video Highlights
            </h3>
            <div class="max-w-5xl">
              <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {videoGallery.map((item) => (
                  <figure
                    class="flex w-full max-w-[18rem] flex-col gap-3 text-left"
                    data-reveal
                  >
                    <div class="aspect-[9/16] w-full overflow-hidden rounded-2xl bg-black">
                      <video
                        class="h-full w-full object-cover"
                        preload="none"
                        loop
                        playsinline
                        controls
                        poster={item.poster}
                        aria-label={item.alt ?? item.title}
                      >
                        <source src={item.video} type="video/mp4" />Your
                        browser does not support HTML5 video.
                      </video>
                    </div>
                    <figcaption>
                      <p class="font-semibold text-slate-900">{item.title}</p>
                      <p class="text-sm text-brand-river">{item.subtitle}</p>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          </div>
        )
      }
    </div>
    <p class="mt-8 text-center text-brand-mist text-sm">
      These photos are from F.O.O.G.'s recent activities.
    </p>
  </section>
</BaseLayout>
