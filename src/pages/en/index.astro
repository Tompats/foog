---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TripCard from "../../components/TripCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import AnnouncementBanner from "../../components/AnnouncementBanner.astro";
import { trips, getLocalizedTrip } from "../../data/trips";
import {
  announcements,
  getLocalizedAnnouncement,
} from "../../data/announcements";
import {
  siteMetadata,
  organizationId,
  getSiteBaseUrl,
  getLocalizedSiteMetadata,
} from "../../data/site";
import { withLocale } from "../../utils/url";
import foogVoras from "../../assets/images/foog-voras-profitis-hlias.jpg";
import heroBorovets from "../../assets/images/foog-borovets-hiking-2025.jpg";
import heroBorovetsTwo from "../../assets/images/foog-borovets-hiking-2025-2.jpg";
import heroGrammos from "../../assets/images/foog-aetomilitsa-grammos-1.jpeg";
import heroBorevetsSki from "../../assets/images/foog-borovets.jpg";
import heroSkiJuniorLesson from "../../assets/images/foog-ski-junior.jpg";
import heroAlexiptoto from "../../assets/images/foog-ski-camp-alexiptoto.jpg";
import heroSnowboardCamp from "../../assets/images/foog-snowboard-camp-junior.jpg";
import { isTripUpcoming, isTripPast, isAnnouncementActive } from "../../types";

const locale = "en" as const;

const rawBannerAnnouncement = [...announcements]
  .filter((announcement) => isAnnouncementActive(announcement))
  .sort((a, b) => {
    if (!!a.urgent !== !!b.urgent) return a.urgent ? -1 : 1;
    return (
      new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime()
    );
  })[0];
const bannerAnnouncement = rawBannerAnnouncement
  ? getLocalizedAnnouncement(rawBannerAnnouncement, locale)
  : undefined;

const upcomingTrips = [...trips]
  .filter((trip) => isTripUpcoming(trip))
  .sort(
    (a, b) => new Date(a.startDate).getTime() - new Date(b.startDate).getTime(),
  )
  .slice(0, 4)
  .map((trip) => getLocalizedTrip(trip, locale));

const latestReports = [...trips]
  .filter((trip) => isTripPast(trip))
  .sort(
    (a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime(),
  )
  .slice(0, 3);

const features = [
  {
    title: "Ski & snowboard training",
    body: "Weekly lessons at Kaimaktsalan, 3-5 Pigadia, and Seli, with the Club's own equipment and certified coaches for every level.",
    iconClass: "fa-solid fa-person-skiing",
  },
  {
    title: "Trips for every season",
    body: "Day trips and multi-day hikes from Paiko all the way to Olympus, plus trail-running and climbing routes graded by difficulty.",
    iconClass: "fa-solid fa-route",
  },
  {
    title: "Caring for our trails",
    body: "Cleanups, trail marking, tree planting, and support for the Agia Paraskevi refuge keep us close to the mountain and to our local community.",
    iconClass: "fa-solid fa-seedling",
  },
  {
    title: "A community of 250+ members",
    body: "For just €10 a year, families, beginners, and long-time members share rides, routes, and partnerships with clubs across Greece and the Balkans.",
    iconClass: "fa-solid fa-users",
  },
];

const heroStats = [
  {
    target: 30,
    suffix: "+",
    valueClass: "text-3xl text-brand-pine",
    label: "Trips/year",
  },
  {
    target: 250,
    suffix: "+",
    valueClass: "text-3xl text-brand-terracotta",
    label: "Members",
  },
  {
    target: null,
    display: "∞",
    valueClass: "text-5xl text-brand-moss",
    label: "Stories",
  },
];

const heroGallery = [
  {
    image: heroAlexiptoto,
    alt: "Children playing under a colorful parachute at a ski resort",
    caption: "Playtime in the snow",
  },
  {
    image: heroBorovets,
    alt: "F.O.O.G. hiking trip in Borovets",
    caption: "Borovets · Mountaineering 2025",
  },
  {
    image: heroBorovetsTwo,
    alt: "Group walking toward the summit",
    caption: "Hiking · Rila",
  },
  {
    image: heroGrammos,
    alt: "F.O.O.G. ascent of Mount Grammos",
    caption: "Mountaineering · Grammos",
  },
  {
    image: heroBorevetsSki,
    alt: "F.O.O.G. trip to Borovets",
    caption: "Borovets · 2-day ski trip",
  },
  {
    image: heroSkiJuniorLesson,
    alt: "Small-group training at 3-5 Pigadia",
    caption: "Ski training - 3/5 Pigadia",
  },
  {
    image: heroSnowboardCamp,
    alt: "Children with snowboards and a coach on a snowy slope",
    caption: "Junior snowboard program",
  },
];

const homepageStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${getSiteBaseUrl()}#website`,
  url: getSiteBaseUrl(),
  name: siteMetadata.name,
  alternateName: siteMetadata.shortName,
  inLanguage: getLocalizedSiteMetadata(locale).inLanguage,
  description: siteMetadata.description,
  publisher: { "@id": organizationId },
};
---

<BaseLayout locale={locale} structuredData={[homepageStructuredData]}>
  {
    bannerAnnouncement && (
      <div class="px-6 sm:px-8 lg:px-12">
        <AnnouncementBanner announcement={bannerAnnouncement} locale={locale} />
      </div>
    )
  }
  <section class="section-padding pt-10" data-reveal>
    <div
      class="glass-panel px-8 py-14 lg:px-12 lg:py-20 overflow-hidden relative"
    >
      <div
        class="absolute inset-y-0 right-0 w-1/2 opacity-30 pointer-events-none hidden lg:block"
      >
        <svg
          viewBox="0 0 400 400"
          class="w-full h-full"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M0 360L120 210L200 290L320 150L400 220V400H0Z"
            fill="url(#grad)"></path>
          <defs
            ><linearGradient id="grad" x1="0" x2="1" y1="0" y2="1"
              ><stop offset="0%" stop-color="#A7C957" stop-opacity="0.6"
              ></stop><stop
                offset="100%"
                stop-color="#E26D5A"
                stop-opacity="0.4"></stop></linearGradient
            ></defs
          >
        </svg>
      </div>
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,1fr),700px] lg:items-center"
      >
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-brand-pine">
            F.O.O.G · Nature-loving Mountaineering Club of Giannitsa
          </p>
          <h1
            class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-semibold text-brand-rocky heading-font max-w-3xl"
          >
            The mountains are calling...and I must go.
          </h1>
          <p class="mt-6 text-lg text-brand-mist max-w-2xl">
            We started in 1973 with five friends in Giannitsa, and today we're
            more than 250 active members. Ski lessons, hikes, and environmental
            action. Whatever your level, there's a place for you.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href={withLocale(locale, "/trips")}
              class="btn-ripple inline-flex items-center justify-center rounded-full bg-brand-terracotta px-8 py-3 text-base font-semibold text-brand-cloud shadow-lg shadow-brand-terracotta/40 transition hover:scale-105 hover:text-brand-cloud"
              >See upcoming trips</a
            >
            <a
              href={withLocale(locale, "/join")}
              class="btn-ripple inline-flex items-center justify-center rounded-full border border-brand-pine/30 px-8 py-3 text-base font-semibold text-brand-pine hover:border-brand-terracotta hover:text-brand-terracotta transition"
              >Become a member</a
            >
          </div>
        </div>
        <figure class="relative mt-4 lg:mt-0 lg:w-[700px]" data-tilt="6">
          <div
            class="relative rounded-[32px] overflow-hidden shadow-2xl shadow-brand-river/40 border border-brand-river/30 h-80 lg:h-[440px] bg-brand-river/10"
          >
            <Image
              src={foogVoras}
              alt="F.O.O.G. flag on a snow-capped summit"
              class="h-full w-full object-cover"
              loading="lazy"
              quality={70}
              sizes="(min-width: 1024px) 700px, 100vw"
            />
            <div
              class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-brand-river/60"
            >
            </div>
            <figcaption
              class="absolute bottom-4 left-4 text-brand-cloud text-sm font-semibold"
            >
              Mount Voras – Profitis Ilias summit
            </figcaption>
          </div>
        </figure>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-3 text-center">
        {
          heroStats.map((stat) => (
            <div class="rounded-2xl bg-brand-cloud/70 py-6 px-4 shadow-sm flex flex-col items-center justify-center min-h-[140px]">
              <p class={`font-bold heading-font ${stat.valueClass}`}>
                {stat.target !== null ? (
                  <>
                    <span
                      data-stat-value
                      data-target={stat.target}
                      aria-live="polite"
                    >
                      0
                    </span>
                    {stat.suffix}
                  </>
                ) : (
                  stat.display
                )}
              </p>
              <p class="mt-2 text-xs uppercase tracking-[0.3em] text-brand-mist">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
      <div class="mt-12 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-brand-mist">
              Snapshots
            </p>
            <h2 class="text-xl font-semibold text-brand-rocky heading-font">
              Latest photos from the crew
            </h2>
          </div>
          <div class="flex gap-2">
            <button
              type="button"
              class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-brand-river/30 text-brand-mist hover:text-brand-terracotta hover:border-brand-terracotta transition"
              aria-label="Previous photo"
              data-gallery-prev
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 6 9 12l6 6"></path></svg
              >
            </button>
            <button
              type="button"
              class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-brand-river/30 text-brand-mist hover:text-brand-terracotta hover:border-brand-terracotta transition"
              aria-label="Next photo"
              data-gallery-next
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m9 6 6 6-6 6"></path></svg
              >
            </button>
          </div>
        </div>
        <div class="relative">
          <div
            class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide"
            data-gallery-track
            role="listbox"
            aria-label="F.O.O.G. photo gallery"
          >
            {
              heroGallery.map((photo, index) => (
                <figure
                  class="w-[75%] sm:w-[320px] lg:w-[360px] snap-start shrink-0"
                  data-gallery-card
                  data-selected={index === 0 ? "true" : "false"}
                  aria-selected={index === 0 ? "true" : "false"}
                  role="option"
                  tabindex={index === 0 ? "0" : "-1"}
                >
                  <div class="carousel-card relative h-56 sm:h-64 rounded-3xl overflow-hidden">
                    <Image
                      src={photo.image}
                      alt={photo.alt}
                      width={720}
                      height={512}
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-brand-river/70 via-transparent to-transparent" />
                    <figcaption
                      class="carousel-caption absolute bottom-4 left-4 text-brand-cloud text-sm font-semibold"
                      data-gallery-caption
                      aria-hidden={index === 0 ? "false" : "true"}
                    >
                      {photo.caption}
                    </figcaption>
                  </div>
                </figure>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding" id="upcoming-trips" data-reveal>
    <SectionHeader
      eyebrow="Planning"
      title="Upcoming adventures"
      subtitle="Small groups, careful planning, and coach support"
    />
    {
      upcomingTrips.length > 0 ? (
        <div class="grid gap-6 lg:grid-cols-2">
          {upcomingTrips.map((trip) => (
            <TripCard trip={trip} locale={locale} />
          ))}
        </div>
      ) : (
        <div class="glass-panel p-6 text-brand-mist text-center">
          <p class="text-lg font-semibold text-brand-rocky">
            There are no trips scheduled right now.
          </p>
          <p class="mt-2">
            Check out our past trips, or get in touch to hear about what's
            coming next.
          </p>
        </div>
      )
    }
    <div class="mt-10 text-center">
      <a
        href={withLocale(locale, "/trips")}
        class="inline-flex items-center gap-2 rounded-full border border-brand-cloud/50 px-6 py-3 text-sm font-semibold text-brand-cloud hover:border-brand-terracotta hover:text-brand-terracotta"
      >
        All trips
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 12h14m-6-6 6 6-6 6"></path></svg
        >
      </a>
    </div>
  </section>

  <section class="section-padding" data-reveal>
    <div class="grid gap-10 lg:grid-cols-[1.1fr,0.9fr] items-center">
      <div>
        <SectionHeader
          eyebrow="Identity"
          title="Rooted in Giannitsa"
          subtitle="Since 1973 we've brought people closer to nature through solidarity and shared learning."
        />
        <div class="glass-panel p-8 space-y-4 text-brand-mist bg-brand-river/5">
          <p>
            Today F.O.O.G. is more than 250 people who share the same passion
            for the mountains — from kids taking their first steps on skis to
            longtime members who still climb every weekend. Experienced guides
            and coaches make sure there's a path for every level, from a first
            hike to the most demanding mountaineering ascents. Trail cleanups,
            tree planting, and caring for our refuge keep us tied to our home,
            not just to the mountain. We meet every Wednesday 18:30–21:00 at our
            wooden clubhouse in Giannitsa, where we plan the next trip and
            welcome anyone who wants to experience it with us.
          </p>
          <a
            href={withLocale(locale, "/history")}
            class="inline-flex items-center gap-2 text-brand-pine font-semibold"
          >
            Read our full story
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12h14m-6-6 6 6-6 6"></path></svg
            >
          </a>
        </div>
      </div>
      <div class="grid gap-6">
        {
          features.map((feature) => (
            <div class="glass-panel p-6 flex items-start gap-4 transition hover:-translate-y-1 bg-brand-cloud/95">
              <div class="h-12 w-12 rounded-full bg-brand-cloud flex items-center justify-center text-brand-pine shadow-inner shrink-0">
                <i class={`${feature.iconClass} text-2xl`} aria-hidden="true" />
              </div>
              <div>
                <h2 class="text-xl font-semibold text-brand-rocky heading-font">
                  {feature.title}
                </h2>
                <p class="text-brand-mist text-sm mt-2">{feature.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    [data-gallery-card] {
      transition:
        opacity 200ms ease,
        transform 200ms ease;
    }
    [data-gallery-card][data-selected="false"] {
      opacity: 0.55;
    }
    [data-gallery-card] .carousel-card {
      transition:
        transform 250ms ease,
        box-shadow 250ms ease;
    }
    [data-gallery-card][data-selected="false"] .carousel-card {
      transform: scale(0.97);
    }
    [data-gallery-card][data-selected="true"] .carousel-card {
      box-shadow: 0 10px 26px rgba(16, 44, 51, 0.25);
    }
    .carousel-caption {
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 250ms ease,
        transform 250ms ease;
    }
    [data-gallery-card][data-selected="true"] .carousel-caption {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <script>
    (() => {
      // autoplayTimer lives outside initCarousel so a leftover interval from a
      // previous client-side navigation gets cleared before a new one starts.
      let autoplayTimer: number | undefined;
      const stopAutoplay = () => {
        if (autoplayTimer === undefined) return;
        window.clearInterval(autoplayTimer);
        autoplayTimer = undefined;
      };

      const initCarousel = () => {
        stopAutoplay();

        const track = document.querySelector<HTMLElement>(
          "[data-gallery-track]",
        );
        if (!track) return;

        const prevButton = document.querySelector<HTMLElement>(
          "[data-gallery-prev]",
        );
        const nextButton = document.querySelector<HTMLElement>(
          "[data-gallery-next]",
        );
        const cards = Array.from(
          track.querySelectorAll<HTMLElement>("[data-gallery-card]"),
        );
        if (!cards.length) return;

        let activeIndex = Math.max(
          0,
          cards.findIndex((card) => card.dataset.selected === "true"),
        );
        const AUTOPLAY_DELAY = 3500;
        let scrollFrame: number | undefined;
        let suppressScrollSync = false;
        let suppressScrollTimeout: number | undefined;

        const getMaxScrollLeft = () =>
          Math.max(0, track.scrollWidth - track.clientWidth);
        const isAtStart = () => track.scrollLeft <= 4;
        const isAtEnd = () => getMaxScrollLeft() - track.scrollLeft <= 4;

        const updateSelection = () => {
          cards.forEach((card, index) => {
            const isSelected = index === activeIndex;
            card.dataset.selected = isSelected ? "true" : "false";
            card.setAttribute("aria-selected", String(isSelected));
            card.setAttribute("tabindex", isSelected ? "0" : "-1");
            const caption = card.querySelector("[data-gallery-caption]");
            if (caption) {
              caption.setAttribute("aria-hidden", String(!isSelected));
            }
          });
        };

        const temporarilyDisableScrollSync = (duration = 450) => {
          suppressScrollSync = true;
          window.clearTimeout(suppressScrollTimeout);
          suppressScrollTimeout = window.setTimeout(() => {
            suppressScrollSync = false;
          }, duration);
        };

        const scrollToActive = (behavior: ScrollBehavior = "smooth") => {
          const activeCard = cards[activeIndex];
          if (!activeCard) return;
          const maxScrollLeft = getMaxScrollLeft();
          const idealLeft =
            activeCard.offsetLeft -
            (track.clientWidth - activeCard.clientWidth) / 2;
          const nextScrollLeft = Math.min(
            maxScrollLeft,
            Math.max(0, idealLeft),
          );
          const distance = Math.abs(nextScrollLeft - track.scrollLeft);
          const duration =
            behavior === "smooth"
              ? Math.min(1000, Math.max(450, distance * 0.8))
              : 200;
          temporarilyDisableScrollSync(duration);
          track.scrollTo({ left: nextScrollLeft, behavior });
        };

        type CarouselTransitionOptions = {
          scrollBehavior?: ScrollBehavior;
        };

        const goToIndex = (
          nextIndex: number,
          options: CarouselTransitionOptions = {},
        ) => {
          if (!cards.length) return;
          const { scrollBehavior = "smooth" } = options;
          const total = cards.length;
          activeIndex = ((nextIndex % total) + total) % total;
          updateSelection();
          scrollToActive(scrollBehavior);
        };

        const showNext = () => goToIndex(activeIndex + 1);
        const showPrev = () => goToIndex(activeIndex - 1);

        const startAutoplay = () => {
          if (autoplayTimer || cards.length <= 1) return;
          autoplayTimer = window.setInterval(() => {
            showNext();
          }, AUTOPLAY_DELAY);
        };

        const restartAutoplay = () => {
          stopAutoplay();
          startAutoplay();
        };

        prevButton?.addEventListener("click", () => {
          showPrev();
          restartAutoplay();
        });

        nextButton?.addEventListener("click", () => {
          showNext();
          restartAutoplay();
        });

        cards.forEach((card, index) => {
          card.addEventListener("click", () => {
            if (index === activeIndex) return;
            goToIndex(index);
            restartAutoplay();
          });

          card.addEventListener("focus", () => {
            if (document.activeElement !== card) return;
            activeIndex = index;
            updateSelection();
          });

          card.addEventListener("keydown", (event: KeyboardEvent) => {
            if (event.key === "ArrowRight") {
              event.preventDefault();
              showNext();
              restartAutoplay();
            } else if (event.key === "ArrowLeft") {
              event.preventDefault();
              showPrev();
              restartAutoplay();
            }
          });
        });

        const attachAutoplayListeners = (element: HTMLElement | null) => {
          if (!element) return;
          element.addEventListener("pointerenter", stopAutoplay);
          element.addEventListener("pointerleave", startAutoplay);
          element.addEventListener("touchstart", stopAutoplay, {
            passive: true,
          });
          element.addEventListener("touchend", startAutoplay);
        };

        attachAutoplayListeners(track);
        attachAutoplayListeners(prevButton);
        attachAutoplayListeners(nextButton);

        track.addEventListener(
          "wheel",
          () => {
            stopAutoplay();
          },
          { passive: true },
        );

        const syncSelectionToScroll = () => {
          if (isAtStart()) {
            if (activeIndex !== 0) {
              activeIndex = 0;
              updateSelection();
            }
            return;
          }

          if (isAtEnd()) {
            const lastIndex = cards.length - 1;
            if (activeIndex !== lastIndex) {
              activeIndex = lastIndex;
              updateSelection();
            }
            return;
          }

          const center = track.scrollLeft + track.clientWidth / 2;
          let closestIndex = activeIndex;
          let smallestDistance = Number.POSITIVE_INFINITY;

          cards.forEach((card, index) => {
            const cardCenter = card.offsetLeft + card.clientWidth / 2;
            const distance = Math.abs(cardCenter - center);
            if (distance < smallestDistance) {
              smallestDistance = distance;
              closestIndex = index;
            }
          });

          if (closestIndex !== activeIndex) {
            activeIndex = closestIndex;
            updateSelection();
          }
        };

        track.addEventListener("scroll", () => {
          if (suppressScrollSync) return;
          if (scrollFrame !== undefined) {
            window.cancelAnimationFrame(scrollFrame);
          }
          scrollFrame = window.requestAnimationFrame(syncSelectionToScroll);
        });

        updateSelection();
        startAutoplay();
      };

      document.addEventListener("astro:page-load", initCarousel);
    })();
  </script>

  <script is:inline>
    (() => {
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

      const animateValue = (el) => {
        const target = Number(el.dataset.target ?? 0);
        if (prefersReducedMotion) {
          el.textContent = target.toLocaleString("en-GB");
          return;
        }

        const duration = 1400;
        const start = performance.now();

        const tick = (now) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = easeOutCubic(progress);
          const current = Math.round(target * eased);
          el.textContent = current.toLocaleString("en-GB");
          if (progress < 1) requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      };

      const initHeroStats = () => {
        const statElements = document.querySelectorAll("[data-stat-value]");
        if (!statElements.length) return;

        if (prefersReducedMotion || !("IntersectionObserver" in window)) {
          statElements.forEach((el) => animateValue(el));
          return;
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animateValue(entry.target);
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.4, rootMargin: "0px 0px -10% 0px" },
        );

        statElements.forEach((el) => observer.observe(el));
      };

      document.addEventListener("astro:page-load", initHeroStats);
    })();
  </script>
</BaseLayout>
