---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { withLocale } from "../../utils/url";

const locale = "en" as const;

const benefits = [
  "Ski and mountaineering lessons with experienced guides, in groups split by level for greater safety.",
  "Borrowed gear (ski, snowboard, poles, boots, helmet) from the Club's stock, whenever you need it.",
  "Participation in hikes, mountaineering trips, and night hikes.",
  "Invitations to cleanups, tree-plantings, and group outings.",
];

const steps = [
  "Talk to our team and help us understand your experience in the outdoors.",
  "Pay the €10 annual membership fee that keeps the gear and activities running.",
  "Attend the safety briefing and meet the guides before your first trip.",
  "Sign up for trips or environmental activities and connect with the community.",
];

const impactStats = [
  {
    label: "Active members",
    value: 82,
    suffix: "+",
    description: "join in activities every season",
  },
  {
    label: "Winter trips",
    value: 28,
    suffix: "/year",
    description: "in Pindus, Voras and Vermio",
  },
  {
    label: "Coaches & guides",
    value: 14,
    suffix: "+",
    description: "certified volunteers",
  },
  {
    label: "Volunteer hours",
    value: 320,
    suffix: "+",
    description: "in cleanups and tree-planting",
  },
];
---

<BaseLayout
  locale={locale}
  title="Join us"
  description="Join F.O.O.G. and enjoy training, mentoring, and alpine adventures."
>
  <section class="section-padding" data-reveal>
    <SectionHeader
      eyebrow="Member"
      title="Join us"
      subtitle="Open to skiers, hikers, and new mountaineers of all ages"
      level={1}
    />
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="glass-panel shimmer-hover p-8 space-y-5">
        <h3 class="text-2xl font-semibold text-brand-rocky">
          Why join F.O.O.G.?
        </h3>
        <ul class="space-y-3 text-brand-mist">
          {
            benefits.map((benefit) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 h-2 w-2 rounded-full bg-brand-terracotta shrink-0" />
                <span>{benefit}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6">
          <h4 class="text-xl font-semibold text-brand-rocky">
            Annual membership
          </h4>
          <div class="mt-4 grid gap-4">
            <div
              class="rounded-2xl border border-brand-river/80 bg-brand-river/70 p-4"
            >
              <p class="text-sm uppercase tracking-[0.3em] text-brand-cloud/80">
                Active member
              </p>
              <p class="text-3xl font-bold text-brand-rocky">
                10€<span class="text-base font-normal text-brand-mist">
                  / year</span
                >
              </p>
              <p class="text-sm text-brand-cloud/80">
                A single fee for all members that covers participation in
                activities, briefings, and access to the Club's equipment.
              </p>
            </div>
            <p class="text-xs text-brand-mist">
              Optional financial support is recorded at sign-up and goes
              toward the junior ski programs, tree-plantings, and the club's
              upkeep.
            </p>
          </div>
        </div>
      </div>
      <div class="glass-panel shimmer-hover p-8 space-y-6">
        <h3 class="text-2xl font-semibold text-brand-rocky">Steps to join</h3>
        <ol class="space-y-4">
          {
            steps.map((step, index) => (
              <li class="flex gap-4">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-moss/20 text-brand-pine font-semibold">
                  {index + 1}
                </span>
                <p class="text-brand-rocky">{step}</p>
              </li>
            ))
          }
        </ol>
        <div
          class="rounded-2xl border border-brand-moss/50 bg-brand-moss/15 p-6 text-center"
        >
          <p class="text-brand-rocky">Ready for new summits?</p>
          <a
            href={withLocale(locale, "/contact")}
            class="btn-ripple mt-4 inline-flex items-center justify-center rounded-full bg-brand-terracotta px-6 py-3 font-semibold text-brand-cloud shadow-lg shadow-brand-terracotta/40 transition hover:scale-105 hover:text-brand-cloud"
          >
            Get in touch with our team
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-padding pt-0" data-reveal>
    <div class="glass-panel shimmer-hover px-8 py-10 space-y-8">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div>
          <p class="text-xs uppercase tracking-[0.45em] text-brand-mist">
            Community strength
          </p>
          <h3 class="mt-2 text-3xl font-semibold text-brand-rocky heading-font">
            Growing together
          </h3>
        </div>
        <p class="max-w-xl text-brand-mist">
          Every new member means one more guide, safer trips, and more hands
          to help care for the mountain.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {
          impactStats.map((stat) => (
            <div
              class="shimmer-hover rounded-2xl border border-brand-river/25 bg-brand-cloud/80 p-6 text-center shadow-brand-river/10 shadow-lg"
            >
              <p class="text-xs uppercase tracking-[0.35em] text-brand-mist">
                {stat.label}
              </p>
              <p class="mt-3 text-4xl font-bold text-brand-rocky heading-font">
                <span
                  data-stat-value
                  data-target={stat.value}
                  aria-live="polite"
                >
                  0
                </span>
                {stat.suffix && (
                  <span class="ml-1 text-2xl text-brand-mist">{stat.suffix}</span>
                )}
              </p>
              <p class="mt-3 text-sm text-brand-mist">{stat.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <script is:inline>
    (() => {
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

      const animateValue = (el) => {
        const target = Number(el.dataset.target ?? 0);
        if (prefersReducedMotion) {
          el.textContent = target.toLocaleString('en-GB');
          return;
        }

        const duration = 1600;
        const start = performance.now();

        const tick = (now) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = easeOutCubic(progress);
          const current = Math.round(target * eased);
          el.textContent = current.toLocaleString('en-GB');
          if (progress < 1) requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      };

      const initStats = () => {
        const statElements = document.querySelectorAll('[data-stat-value]');
        if (!statElements.length) return;

        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          statElements.forEach((el) => animateValue(el));
          return;
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animateValue(entry.target);
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.4, rootMargin: '0px 0px -10% 0px' }
        );

        statElements.forEach((el) => observer.observe(el));
      };

      document.addEventListener('astro:page-load', initStats);
    })();
  </script>
</BaseLayout>
