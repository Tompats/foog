---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { siteMetadata } from "../../data/site";
import { withLocale } from "../../utils/url";

const locale = "en" as const;

const quickLinks = [
  {
    title: "Upcoming trips",
    description:
      "Check out the hikes, climbs, and ski sessions we have scheduled.",
    href: withLocale(locale, "/trips"),
    icon: "fa-solid fa-map-location-dot",
    cta: "See the schedule",
  },
  {
    title: "Our story",
    description:
      "Learn how F.O.O.G.'s community has grown since 1973 and shaped the mountains around Giannitsa.",
    href: withLocale(locale, "/history"),
    icon: "fa-solid fa-timeline",
    cta: "Meet the club",
  },
  {
    title: "Join us",
    description:
      "Fill out the sign-up form, learn about membership dues, and start sharing trips with us.",
    href: withLocale(locale, "/join"),
    icon: "fa-solid fa-person-hiking",
    cta: "Sign up",
  },
];

const supportActions = [
  {
    label: "Double-check the address",
    detail:
      "It might be a typo — try retyping it, or use the menu to find the section you're looking for.",
  },
  {
    label: "Tell us about the broken link",
    detail: `If you got here through a link on our site, email us at ${siteMetadata.contactEmail} or call ${siteMetadata.phone} so we can fix it.`,
  },
];

const breadcrumbs = [
  { label: "Home", href: withLocale(locale, "/") },
  { label: "404" },
];
---

<BaseLayout
  locale={locale}
  title="Page not found"
  description="The page you requested was not found. Return to a safe path with guidance from F.O.O.G."
  noindex
>
  <section class="section-padding">
    <div class="grid gap-8 lg:grid-cols-[1.1fr,0.9fr] items-stretch">
      <div class="glass-panel px-8 py-12 lg:px-10 lg:py-16 flex flex-col gap-6" data-reveal>
        <nav aria-label="Breadcrumb" class="text-sm text-brand-mist flex items-center gap-2">
          {
            breadcrumbs.map((item, index) => (
              <span class="flex items-center gap-2">
                {item.href ? (
                  <a href={item.href} class="hover:text-brand-terracotta">
                    {item.label}
                  </a>
                ) : (
                  <span aria-current="page">{item.label}</span>
                )}
                {index < breadcrumbs.length - 1 && (
                  <span aria-hidden="true">/</span>
                )}
              </span>
            ))
          }
        </nav>
        <div>
          <p class="text-sm uppercase tracking-[0.4em] text-brand-moss">
            Error 404
          </p>
          <h1 class="mt-4 text-4xl sm:text-5xl font-semibold heading-font text-brand-rocky">
            You've lost the trail
          </h1>
          <p class="mt-5 text-lg text-brand-mist">
            The address you entered doesn't exist or has moved. Check out
            the options below to find what you're looking for.
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a
            href={withLocale(locale, "/")}
            class="btn-ripple inline-flex items-center justify-center rounded-full bg-brand-terracotta px-8 py-3 text-base font-semibold text-brand-cloud shadow-lg shadow-brand-terracotta/40 hover:scale-[1.02] hover:text-brand-cloud"
          >
            Back to home
          </a>
          <a
            href={withLocale(locale, "/trips")}
            class="btn-ripple inline-flex items-center justify-center rounded-full border border-brand-pine/40 px-8 py-3 text-base font-semibold text-brand-pine hover:border-brand-terracotta hover:text-brand-terracotta"
          >
            See the trips
          </a>
        </div>
      </div>
      <div class="glass-panel px-6 py-10 lg:px-8 flex flex-col gap-10" data-reveal>
        <div>
          <SectionHeader
            eyebrow="Suggested paths"
            title="What would you like to do?"
            subtitle="Pick a popular section or talk directly to our team"
            tone="dark"
          />
        </div>
        <div class="space-y-4">
          {
            quickLinks.map((link) => (
              <a
                class="shimmer-hover block rounded-2xl border border-brand-river/30 bg-brand-cloud/70 p-5 transition hover:-translate-y-0.5"
                href={link.href}
              >
                <div class="flex items-start gap-4">
                  <div class="h-12 w-12 rounded-full bg-brand-river/10 text-brand-pine flex items-center justify-center text-xl">
                    <i class={link.icon}></i>
                  </div>
                  <div>
                    <p class="text-lg font-semibold text-brand-rocky">
                      {link.title}
                    </p>
                    <p class="mt-2 text-sm text-brand-mist">
                      {link.description}
                    </p>
                    <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-brand-pine">
                      {link.cta}
                      <i class="fa-solid fa-arrow-right"></i>
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
        <div class="rounded-3xl border border-brand-river/30 bg-brand-river/5 p-6">
          <p class="text-sm uppercase tracking-[0.4em] text-brand-mist">
            F.O.O.G. community
          </p>
          <ul class="mt-4 space-y-4">
            {
              supportActions.map((item) => (
                <li class="flex gap-4">
                  <span class="mt-1 h-3 w-3 rounded-full bg-brand-terracotta shrink-0"></span>
                  <div>
                    <p class="text-base font-semibold text-brand-rocky">
                      {item.label}
                    </p>
                    <p class="text-sm text-brand-mist">{item.detail}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="mt-6 rounded-2xl bg-brand-cloud/80 p-5">
            <p class="text-sm text-brand-mist">Email</p>
            <a
              href={`mailto:${siteMetadata.contactEmail}`}
              class="text-lg font-semibold text-brand-pine"
            >
              {siteMetadata.contactEmail}
            </a>
            <p class="mt-4 text-sm text-brand-mist">Phone</p>
            <a
              href={`tel:${siteMetadata.phone.replace(/\s+/g, "")}`}
              class="text-lg font-semibold text-brand-pine"
            >
              {siteMetadata.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
