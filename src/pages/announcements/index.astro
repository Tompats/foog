---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import AnnouncementCard from "../../components/AnnouncementCard.astro";
import { announcements } from "../../data/announcements";
import { isAnnouncementActive } from "../../types";
import { createCollectionPageJsonLd, absoluteUrl } from "../../utils/seo";

const sortedAnnouncements = announcements
  .filter((announcement) => isAnnouncementActive(announcement))
  .sort((a, b) => {
    if (!!a.urgent !== !!b.urgent) return a.urgent ? -1 : 1;
    return new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime();
  });

const pageUrl = absoluteUrl("/announcements");
const structuredData = createCollectionPageJsonLd("Ανακοινώσεις Φ.Ο.Ο.Γ", pageUrl);
---

<BaseLayout
  title="Ανακοινώσεις"
  description="Ενημερωθείτε για αρχαιρεσίες, αλλαγές προγράμματος και άλλες ανακοινώσεις του Φ.Ο.Ο.Γ."
  structuredData={structuredData}
>
  <section class="section-padding">
    <div data-reveal>
      <SectionHeader
        eyebrow="Ενημέρωση"
        title="Ανακοινώσεις"
        subtitle="Ό,τι πρέπει να ξέρεις αυτή τη στιγμή για τον Όμιλο"
        level={1}
      />
    </div>
    {
      sortedAnnouncements.length > 0 ? (
        <div class="grid gap-6 max-w-3xl mx-auto">
          {sortedAnnouncements.map((announcement) => (
            <div data-reveal>
              <AnnouncementCard announcement={announcement} />
            </div>
          ))}
        </div>
      ) : (
        <div class="glass-panel p-6 text-brand-mist text-center max-w-2xl mx-auto">
          <p class="text-lg font-semibold text-brand-rocky">
            Δεν υπάρχουν ενεργές ανακοινώσεις αυτή τη στιγμή.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
