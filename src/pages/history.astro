---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { withBase } from "../utils/url";
import heroBase from "../assets/images/foog-base.jpg";
import heroEuropeanSkiChampionship from "../assets/images/foog-prodromos-xanthopoulos-slovenia.jpg";

const timeline = [
  {
    year: "1973",
    title: "Η αρχή από πέντε φίλους",
    description:
      "Στα Γιαννιτσά, μια μικρή παρέα δημιούργησε τον Φ.Ο.Ο.Γ. για να προσφέρει πρόσβαση στη φύση και ασφαλείς ορεινές δραστηριότητες.",
  },
  {
    year: "1977",
    title: "Επίσημη αναγνώριση",
    description:
      "Το νέο καταστατικό ενσωμάτωσε τη χιονοδρομία, την ορειβασία και την αναρρίχηση ως βασικούς πυλώνες.",
  },
  {
    year: "2000",
    title: "Δράσεις σε όλη την Ελλάδα",
    description:
      "Ημερήσιες και διήμερες αποστολές από το Πάικο μέχρι τον Παρνασσό καθιέρωσαν τη φήμη του ομίλου σε όλη τη Βόρεια Ελλάδα.",
  },
  {
    year: "2010",
    title: "Κρίση και επανεκκίνηση",
    description:
      "Η οικονομική κρίση περιόρισε τις δράσεις, όμως νέοι άνθρωποι έφεραν πνοή, κράτησαν ζωντανό το πρόγραμμα και άνοιξαν χώρο για αρχάριους.",
  },
  {
    year: "2023",
    title: "250+ μέλη σε δράση",
    description:
      "Μαθήματα σκι, καθαρισμοί, δεντροφυτεύσεις και συνεργασίες με συλλόγους στην Ελλάδα και τα Βαλκάνια δείχνουν το σύγχρονο πρόσωπο του Φ.Ο.Ο.Γ.",
  },
];
---

<BaseLayout
  title="Ιστορία"
  description="Ανακάλυψε τις δεκαετίες ευθύνης, εκπαίδευσης και αλπικών περιπετειών που έχτισαν τον Φ.Ο.Ο.Γ."
>
  <section class="section-padding">
    <div data-reveal>
      <SectionHeader
        eyebrow="Ιστορία"
        title="Πορεία του ομίλου"
        subtitle="Από πέντε φίλους το 1973 σε μια κοινότητα που αγαπά το βουνό"
        level={1}
      />
    </div>
    <div class="glass-panel p-8" data-reveal>
      <article class="prose max-w-none">
        <p>
          Ο Φ.Ο.Ο.Γ. γεννήθηκε το 1973, όταν πέντε φυσιολάτρες από τα Γιαννιτσά
          ένωσαν τις δυνάμεις τους για να φέρουν την κοινότητα πιο κοντά στο
          βουνό. Πήραμε επίσημη αναγνώριση το 1977 και, παρά την οικονομική
          κρίση του 2010 που μας δυσκόλεψε, συνεχίσαμε να μεγαλώνουμε. Σήμερα
          αριθμούμε 250+ ενεργά μέλη που στηρίζουν εθελοντικά κάθε δράση.
        </p>
        <p>
          Μέλη μας έχουν ανέβει στο βάθρο πανελλήνιων αγώνων σκι και έχουν
          εκπροσωπήσει την Ελλάδα στο εξωτερικό. Παράλληλα, οι συνεργασίες με
          το δασαρχείο, την υπηρεσία πρασίνου και αδελφούς συλλόγους, καθώς και
          η αναβίωση του καταφυγίου στην Αγία Παρασκευή, δείχνουν πόσο σοβαρά
          παίρνουμε τη σχέση μας με το βουνό. Από τις νυχτερινές πεζοπορίες της
          Πανσελήνου και τις διαδρομές μνήμης της 19ης Οκτωβρίου μέχρι τα
          ταξίδια στο Μπόροβιτς της Βουλγαρίας, συνεχίζουμε να καλωσορίζουμε
          νέους και παλιούς που θέλουν να αγαπήσουν τη φύση.
        </p>
      </article>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <Image
          src={heroBase}
          alt="Σπιτάκι του συλλόγου"
          class="rounded-2xl object-cover h-64 w-full"
          loading="lazy"
          width={900}
          widths={[500, 900]}
          quality={75}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
        <Image
          src={heroEuropeanSkiChampionship}
          alt="Κατάβαση με σκι"
          class="rounded-2xl object-cover h-64 w-full"
          loading="lazy"
          width={900}
          widths={[500, 900]}
          quality={75}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      </div>
    </div>
    <div class="mt-12 space-y-4">
      {
        timeline.map((item) => (
          <div
            class="glass-panel p-6 flex flex-col gap-2 lg:flex-row lg:items-center lg:gap-8"
            data-reveal
          >
            <p class="text-3xl font-black text-brand-pine">{item.year}</p>
            <div>
              <h3 class="text-xl font-semibold text-brand-rocky">
                {item.title}
              </h3>
              <p class="text-brand-mist">{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>
    <p class="mt-10 text-center">
      <a
        href={withBase("/board")}
        class="inline-flex items-center gap-2 rounded-full border border-brand-cloud/50 px-6 py-3 text-sm font-semibold text-brand-cloud hover:border-brand-terracotta hover:text-brand-terracotta"
      >
        Γνώρισε το Διοικητικό Συμβούλιο
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 12h14m-6-6 6 6-6 6"></path>
        </svg>
      </a>
    </p>
  </section>
</BaseLayout>
