---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CoachCard from "../components/CoachCard.astro";
import { coaches } from "../data/coaches";
import skiTeam from "../assets/images/foog-ski-camp-omada-1.jpg";
import heroSkiJuniorLesson from "../assets/images/foog-agonistiko-ski-1.jpg";
---

<BaseLayout
  title="Χιονοδρομία"
  description="Γνώρισε τους πιστοποιημένους προπονητές σκι, ορειβασίας και αναρρίχησης του Φ.Ο.Ο.Γ."
>
  <div class="winter-snow">
    <canvas class="winter-snow-canvas" aria-hidden="true"></canvas>
    <section class="section-padding" data-reveal>
      <SectionHeader
        eyebrow="Χειμερινά Σπορ"
        title="Ski & Snowboard στον Φ.Ο.Ο.Γ."
        subtitle="Εξορμήσεις σε κορυφαία χιονοδρομικά, παροχή εξοπλισμού και καθοδήγηση για κάθε επίπεδο."
        level={1}
      />
      <div class="glass-panel space-y-6 px-8 py-10 text-brand-rocky">
        <p class="text-lg font-semibold text-brand-pine">
          Χιονοδρομία στο κλαμπ μας
        </p>
        <p>
          Η χειμερινή μας ομάδα οργανώνει εξορμήσεις σκι και snowboard για όλα
          τα επίπεδα — αναλαμβάνουμε τις μετακινήσεις, την εκπαίδευση, και
          φροντίζουμε να νιώθεις ασφάλεια στο βουνό.
        </p>
        <div class="grid gap-4 md:grid-cols-2">
          <div
            class="rounded-2xl border border-brand-river/30 bg-white/70 p-4 shadow-sm"
            data-reveal
          >
            <p class="font-semibold text-brand-terracotta">
              3 αγαπημένα χιονοδρομικά
            </p>
            <p class="text-sm text-brand-mist">
              Επισκεπτόμαστε τρία κορυφαία χιονοδρομικά της Βόρειας Ελλάδας με
              οργανωμένη μετακίνηση και πλάνο διαδρομών.
            </p>
          </div>
          <div
            class="rounded-2xl border border-brand-river/30 bg-white/70 p-4 shadow-sm"
            data-reveal
          >
            <p class="font-semibold text-brand-terracotta">
              Εξοπλισμός & ασφάλεια
            </p>
            <p class="text-sm text-brand-mist">
              Παρέχουμε βασικό εξοπλισμό, συμβουλές rental και ενημέρωση
              ασφάλειας για σκι και snowboard.
            </p>
          </div>
          <div
            class="rounded-2xl border border-brand-river/30 bg-white/70 p-4 shadow-sm"
            data-reveal
          >
            <p class="font-semibold text-brand-terracotta">
              Μαθήματα για όλα τα επίπεδα
            </p>
            <p class="text-sm text-brand-mist">
              Από τα πρώτα σου γλιστρήματα μέχρι τεχνικές freeride, μαζί με τους
              έμπειρους προπονητές μας.
            </p>
          </div>
          <div
            class="rounded-2xl border border-brand-river/30 bg-white/70 p-4 shadow-sm"
            data-reveal
          >
            <p class="font-semibold text-brand-terracotta">Ομαδικά weekends</p>
            <p class="text-sm text-brand-mist">
              Σαββατοκύριακα με κοινή διαμονή, after-ski δραστηριότητες και
              συνεχή υποστήριξη της ομάδας.
            </p>
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <figure
            class="tilt-card aspect-[4/3] overflow-hidden rounded-2xl"
            data-tilt="5"
            data-reveal
          >
            <Image
              src={skiTeam}
              alt="Ομάδα του Φ.Ο.Ο.Γ. σε εξόρμηση σκι"
              class="h-full w-full object-cover"
              loading="lazy"
              width={900}
              widths={[500, 900]}
              quality={75}
              sizes="(min-width: 768px) 50vw, 100vw"
            />
            <figcaption class="mt-2 text-sm text-brand-mist">
              Weekend σκι στο Μπόροβιτς
            </figcaption>
          </figure>
          <figure
            class="tilt-card aspect-[4/3] overflow-hidden rounded-2xl"
            data-tilt="5"
            data-reveal
          >
            <Image
              src={heroSkiJuniorLesson}
              alt="Μάθημα σκι για μικρά μέλη"
              class="h-full w-full object-cover"
              loading="lazy"
              width={900}
              widths={[500, 900]}
              quality={75}
              sizes="(min-width: 768px) 50vw, 100vw"
            />
            <figcaption class="mt-2 text-sm text-brand-mist">
              Junior coaching στα 3-5 Πηγάδια
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section class="section-padding pt-0">
      <div data-reveal>
        <SectionHeader
          eyebrow="Ομάδα"
          title="Προπονητές & εκπαιδευτές"
          subtitle="Επαγγελματίες προπονητές, πρώην αθλητές και εθελοντές μέντορες"
        />
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          coaches.map((coach) => (
            <div data-reveal>
              <CoachCard coach={coach} />
            </div>
          ))
        }
      </div>
    </section>
  </div>
  <script>
    const initWinterSnow = () => {
      const canvas = document.querySelector(".winter-snow-canvas");
      const container = canvas?.closest(".winter-snow");
      if (!canvas || !container) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      const makeDotSprite = (radius) => {
        const pad = radius * 1.35;
        const size = Math.ceil(pad * 2);
        const sprite = document.createElement("canvas");
        sprite.width = size;
        sprite.height = size;
        const sctx = sprite.getContext("2d");
        const gradient = sctx.createRadialGradient(pad, pad, 0, pad, pad, pad);
        gradient.addColorStop(0, "rgba(255, 255, 255, 1)");
        gradient.addColorStop(0.7, "rgba(255, 255, 255, 0.9)");
        gradient.addColorStop(1, "rgba(255, 255, 255, 0)");
        sctx.fillStyle = gradient;
        sctx.beginPath();
        sctx.arc(pad, pad, pad, 0, Math.PI * 2);
        sctx.fill();
        return sprite;
      };

      const makeSnowflakeSprite = (radius) => {
        const pad = radius * 1.3;
        const size = Math.ceil(pad * 2);
        const sprite = document.createElement("canvas");
        sprite.width = size;
        sprite.height = size;
        const sctx = sprite.getContext("2d");
        const cx = pad;
        const cy = pad;
        sctx.strokeStyle = "rgba(255, 255, 255, 0.85)";
        sctx.lineCap = "round";
        sctx.lineWidth = Math.max(1, radius / 5);
        for (let i = 0; i < 6; i++) {
          const angle = (Math.PI / 3) * i;
          const dx = Math.cos(angle);
          const dy = Math.sin(angle);
          sctx.beginPath();
          sctx.moveTo(cx, cy);
          sctx.lineTo(cx + dx * radius, cy + dy * radius);
          sctx.stroke();

          const branchX = cx + dx * radius * 0.55;
          const branchY = cy + dy * radius * 0.55;
          const branchLen = radius * 0.32;
          [angle + Math.PI / 6, angle - Math.PI / 6].forEach((branchAngle) => {
            sctx.beginPath();
            sctx.moveTo(branchX, branchY);
            sctx.lineTo(
              branchX + Math.cos(branchAngle) * branchLen,
              branchY + Math.sin(branchAngle) * branchLen,
            );
            sctx.stroke();
          });
        }
        return sprite;
      };

      const sprites = [
        makeDotSprite(1.3),
        makeDotSprite(2.1),
        makeSnowflakeSprite(4.8),
      ];

      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      let width = 0;
      let height = 0;
      let flakes = [];
      let rafId = null;
      let lastTime = 0;
      let windPhase = Math.random() * Math.PI * 2;
      let resizePending = false;

      const spawnFlake = (randomY) => {
        const roll = Math.random();
        const sizeIndex = roll < 0.55 ? 0 : roll < 0.85 ? 1 : 2;
        return {
          baseX: Math.random() * width,
          y: randomY ? Math.random() * height : -12,
          sizeIndex,
          speed: 16 + sizeIndex * 14 + Math.random() * 12,
          swayAmp: 8 + Math.random() * 22,
          swayFreq: 0.25 + Math.random() * 0.5,
          phase: Math.random() * Math.PI * 2,
          opacity: 0.35 + Math.random() * 0.5,
          rotation: Math.random() * Math.PI * 2,
          rotationSpeed: (Math.random() - 0.5) * 0.6,
        };
      };

      const seedFlakes = () => {
        const area = width * height;
        const count = Math.max(30, Math.min(160, Math.round(area / 12000)));
        flakes = Array.from({ length: count }, () => spawnFlake(true));
      };

      const resize = () => {
        resizePending = false;
        width = container.clientWidth;
        height = container.scrollHeight;
        canvas.width = Math.max(1, Math.round(width * dpr));
        canvas.height = Math.max(1, Math.round(height * dpr));
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        seedFlakes();
      };

      const scheduleResize = () => {
        if (resizePending) return;
        resizePending = true;
        requestAnimationFrame(resize);
      };

      const step = (timestamp) => {
        if (!lastTime) lastTime = timestamp;
        const dt = Math.min((timestamp - lastTime) / 1000, 0.05);
        lastTime = timestamp;

        windPhase += dt * 0.15;
        const wind = Math.sin(windPhase) * 12;

        ctx.clearRect(0, 0, width, height);

        for (const flake of flakes) {
          flake.y += flake.speed * dt;
          flake.baseX += wind * dt;
          if (flake.baseX < -20) flake.baseX = width + 20;
          if (flake.baseX > width + 20) flake.baseX = -20;
          flake.rotation += flake.rotationSpeed * dt;

          if (flake.y > height + 20) {
            Object.assign(flake, spawnFlake(false));
            continue;
          }

          const sway =
            Math.sin((timestamp / 1000) * flake.swayFreq + flake.phase) *
            flake.swayAmp;
          const x = flake.baseX + sway;
          const sprite = sprites[flake.sizeIndex];

          ctx.save();
          ctx.globalAlpha = flake.opacity;
          ctx.translate(x, flake.y);
          if (flake.sizeIndex === 2) ctx.rotate(flake.rotation);
          ctx.drawImage(sprite, -sprite.width / 2, -sprite.height / 2);
          ctx.restore();
        }
        ctx.globalAlpha = 1;

        rafId = requestAnimationFrame(step);
      };

      const start = () => {
        lastTime = 0;
        rafId = requestAnimationFrame(step);
      };

      const stop = () => {
        if (rafId !== null) cancelAnimationFrame(rafId);
        rafId = null;
      };

      const handleVisibility = () => {
        if (document.hidden) {
          stop();
        } else {
          start();
        }
      };

      resize();
      start();

      window.addEventListener("resize", scheduleResize);
      document.addEventListener("visibilitychange", handleVisibility);

      const resizeObserver = new ResizeObserver(scheduleResize);
      resizeObserver.observe(container);

      document.addEventListener(
        "astro:before-swap",
        () => {
          stop();
          window.removeEventListener("resize", scheduleResize);
          document.removeEventListener("visibilitychange", handleVisibility);
          resizeObserver.disconnect();
        },
        { once: true },
      );
    };

    document.addEventListener("astro:page-load", initWinterSnow);
  </script>
</BaseLayout>
